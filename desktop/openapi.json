 "components": {
  "schemas": {
   "ArmRequest": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "amount": {
      "type": "string",
      "title": "Amount"
     },
     "at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "At"
     },
     "now": {
      "type": "boolean",
      "title": "Now",
      "default": false
     },
     "dry_run": {
      "type": "boolean",
      "title": "Dry Run",
      "default": false
     },
     "confirm_real_payment": {
      "type": "boolean",
      "title": "Confirm Real Payment",
      "default": false
     },
     "prep_minutes": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Prep Minutes"
     },
     "settings_revision": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Settings Revision"
     },
     "mode": {
      "type": "string",
      "enum": [
       "first_launch",
       "redemption"
      ],
      "title": "Mode",
      "default": "first_launch"
     }
    },
    "type": "object",
    "required": [
     "code",
     "amount"
    ],
    "title": "ArmRequest"
   },
   "BuyRequest": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "amount": {
      "type": "string",
      "title": "Amount"
     },
     "real": {
      "type": "boolean",
      "title": "Real",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "code",
     "amount"
    ],
    "title": "BuyRequest"
   },
   "CancelRequest": {
    "properties": {
     "amount": {
      "type": "string",
      "title": "Amount",
      "default": "0.01"
     },
     "limit": {
      "type": "integer",
      "title": "Limit",
      "default": 0
     },
     "action": {
      "type": "string",
      "enum": [
       "list",
       "dry_run",
       "real"
      ],
      "title": "Action",
      "default": "list"
     }
    },
    "type": "object",
    "title": "CancelRequest"
   },
   "FavoriteRequest": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "title": {
      "type": "string",
      "title": "Title",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "code"
    ],
    "title": "FavoriteRequest"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "PasswordRequest": {
    "properties": {
     "current": {
      "type": "string",
      "title": "Current"
     },
     "new": {
      "type": "string",
      "title": "New"
     }
    },
    "type": "object",
    "required": [
     "current",
     "new"
    ],
    "title": "PasswordRequest"
   },
   "PatternRequest": {
    "properties": {
     "new": {
      "type": "string",
      "title": "New"
     }
    },
    "type": "object",
    "required": [
     "new"
    ],
    "title": "PatternRequest"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}
