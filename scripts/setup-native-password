#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
root="$PWD"
mkdir -p var/native-password
runtime="$root/var/native-password"
build=$(mktemp -d "$runtime/build.XXXXXXXX")
trap 'rm -rf "$build"' EXIT

# Keep the privileged emulator binary and host binding on the same release.
frida_version=17.25.2
if ! python3 - "$runtime/frida-server" <<'PY'
import hashlib
import sys
from pathlib import Path

server = Path(sys.argv[1])
sys.exit(not server.is_file() or hashlib.sha256(server.read_bytes()).hexdigest() !=
         '7bb6219131819c11e5fe53b3e32fae0b8d1ff4c2a9c35c1a549d2703ea0f3b9b')
PY
then
  curl --fail --location --silent --show-error --max-time 120 \
    "https://github.com/frida/frida/releases/download/$frida_version/frida-server-$frida_version-android-arm64.xz" \
    -o "$build/server.xz"
  python3 - "$build" <<'PY'
import hashlib
import lzma
import sys
from pathlib import Path

build = Path(sys.argv[1])
archive = (build / 'server.xz').read_bytes()
if hashlib.sha256(archive).hexdigest() != '08d7b7f02256621c9089cecd6495a5eb43861bf560a7ed86ad376e75d16a1fb6':
    raise SystemExit('Frida 下载校验失败。')
(build / 'frida-server').write_bytes(lzma.decompress(archive))
PY
fi
if ! PYTHONPATH="$runtime/python" python3 - "$frida_version" <<'PY'
import sys

import frida

sys.exit(frida.__version__ != sys.argv[1])
PY
then
  python3 -m pip install --quiet --target "$build/python" "frida==$frida_version"
fi
cp scripts/native-password/package*.json src/native_password_agent.js "$build/"
npm ci --prefix "$build" --no-audit --no-fund
"$build/node_modules/.bin/esbuild" "$build/native_password_agent.js" --bundle --format=iife --platform=neutral --outfile="$build/agent.js"

# The completion marker also pins the source used to build the agent.
python3 - "$build" "$runtime" <<'PY'
import hashlib
import json
import shutil
import sys
from pathlib import Path

build, runtime = map(Path, sys.argv[1:])
marker = runtime / 'manifest.json'
marker.unlink(missing_ok=True)
for name in ('frida-server', 'agent.js'):
    if (build / name).exists():
        (build / name).replace(runtime / name)
(runtime / 'frida-server').chmod(0o700)
if (build / 'python').exists():
    if (runtime / 'python').exists():
        shutil.rmtree(runtime / 'python')
    (build / 'python').replace(runtime / 'python')
marker.write_text(json.dumps({'source_sha256': hashlib.sha256(Path('src/native_password_agent.js').read_bytes()).hexdigest()}))
PY
printf '%s\n' '无键盘密码输入组件已安装。'
